#!/usr/bin/env bash
set -uo pipefail

# Run test-transpiled-local (or a user-specified just target), classify failures.
#
# Usage:
#   bin/classify-failures                    # runs just test-transpiled-local
#   bin/classify-failures test-local         # runs just test-local
#   bin/classify-failures test-backend-local # runs just test-backend-local

target="${1:-test-transpiled-local}"
tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

# For transpiled tests, ensure we test a freshly built binary.
if [[ "$target" == "test-transpiled-local" ]]; then
    rm -f tongues/.out/tongues.py
    echo "Running: just self-transpile"
    if ! just self-transpile >"$tmpfile" 2>&1; then
        echo "Self-transpile failed:"
        cat "$tmpfile"
        exit 1
    fi
    echo
fi

echo "Running: just $target"
echo

just "$target" >"$tmpfile" 2>&1
rc=$?

if [ $rc -eq 0 ]; then
    echo "All tests passed."
    exit 0
fi

python3 - "$tmpfile" <<'PYEOF'
from __future__ import annotations

import re
import sys

RULES: list[tuple[str, str]] = [
    (r"unknown expression", "unknown expression"),
    (r"argument of type .+ is not iterable", "argument not iterable"),
    (r"list index out of range", "list index out of range"),
    (r"'tuple' object has no attribute 'kind'", "tuple has no attr 'kind'"),
    (r"Expected error containing .+ got ok", "expected error, got ok"),
    (r"Assertion failed", "assertion failed (expected error)"),
    (r"Expected not found in output", "expected output not found"),
    (r"Expected ok, got error", "expected ok, got error"),
    (r"KeyError: 'escapes'", "KeyError: 'escapes'"),
    (r"KeyError: 'binder'", "KeyError: 'binder'"),
    (r"KeyError: 'vars'", "KeyError: 'vars'"),
    (r"cannot traverse .+ with key", "KeyError: path traversal"),
    (r"reserved name", "reserved name collision"),
    (r"unreachable catch after catch-all", "unreachable catch false positive"),
    (r"double optional", "double optional not rejected"),
    (r"No reveal_type found", "reveal_type not found"),
    (r"Expected warning containing .+ got none", "expected warning not emitted"),
    (r"Lowering error", "lowering error"),
    (r"Ordering test failed", "ordering test failure"),
    (r"Transpile error", "transpile error (other)"),
    (r"App test failed", "app test runtime failure"),
]


def classify(reason: str) -> str:
    for pattern, label in RULES:
        if re.search(pattern, reason):
            return label
    return "other"


def extract_stage(test_id: str) -> str:
    m = re.search(r"(test_\w+)\[", test_id)
    return m.group(1) if m else "unknown"


path = sys.argv[1]
text = open(path).read()

failures_start = text.find("= FAILURES =")
errors_start = text.find("= ERRORS =")
summary_start = text.rfind("= short test summary")
if summary_start == -1:
    print("No test summary found in output.", file=sys.stderr)
    sys.exit(1)

results: list[tuple[str, str, str]] = []  # (test_id, stage, category)
for section_start in [failures_start, errors_start]:
    if section_start == -1:
        continue
    section = text[section_start:summary_start]
    blocks = re.split(r"^_{3,} (.+?) _{3,}$", section, flags=re.MULTILINE)
    for i in range(1, len(blocks), 2):
        test_id = blocks[i].strip()
        block = blocks[i + 1] if i + 1 < len(blocks) else ""
        e_lines = [
            ln.lstrip()[2:].strip()
            for ln in block.split("\n")
            if ln.lstrip().startswith("E ")
        ]
        reason = " ".join(e_lines)
        stage = extract_stage(test_id)
        cat = classify(reason)
        results.append((test_id, stage, cat))

if not results:
    print("No failures found.")
    sys.exit(0)

# ── By category ──
cat_counts: dict[str, int] = {}
for _, _, cat in results:
    cat_counts[cat] = cat_counts.get(cat, 0) + 1
ranked = sorted(cat_counts.items(), key=lambda x: -x[1])
print("── By category ──")
for cat, count in ranked:
    print(f"  {count:4d}  {cat}")
print(f"  {'─' * 4}")
print(f"  {len(results):4d}  total")

# ── By stage ──
stage_counts: dict[str, int] = {}
for _, stage, _ in results:
    stage_counts[stage] = stage_counts.get(stage, 0) + 1
ranked_stages = sorted(stage_counts.items(), key=lambda x: -x[1])
print()
print("── By stage ──")
for stage, count in ranked_stages:
    print(f"  {count:4d}  {stage}")

# ── Per-stage breakdown ──
stage_cats: dict[str, dict[str, int]] = {}
for _, stage, cat in results:
    if stage not in stage_cats:
        stage_cats[stage] = {}
    stage_cats[stage][cat] = stage_cats[stage].get(cat, 0) + 1
print()
print("── Per-stage breakdown ──")
for stage, _ in ranked_stages:
    cats = stage_cats[stage]
    items = sorted(cats.items(), key=lambda x: -x[1])
    print(f"  {stage} ({sum(cats.values())})")
    for cat, count in items:
        print(f"    {count:4d}  {cat}")

# ── "other" details ──
others = [tid for tid, _, cat in results if cat == "other"]
if others:
    print()
    print(f"── 'other' details ({len(others)}) ──")
    for tid in others:
        print(f"  {tid}")
PYEOF
