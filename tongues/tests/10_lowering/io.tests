=== print with newline
def f(x: int) -> None:
    print(x)
---
Print(x, newline: True)
---

=== print without newline
def f(x: int) -> None:
    print(x, end="")
---
Print(x, newline: False)
---

=== print to stderr
import sys
def f(x: int) -> None:
    print(x, file=sys.stderr)
---
Print(x, stderr: True)
---

=== readline
import sys
def f() -> str:
    return sys.stdin.readline()
---
ReadLine()
---

=== read all stdin
import sys
def f() -> str:
    return sys.stdin.read()
---
ReadAll()
---

=== read bytes
import sys
def f() -> bytes:
    return sys.stdin.buffer.read()
---
ReadBytes()
---

=== read n bytes
import sys
def f(n: int) -> bytes:
    return sys.stdin.buffer.read(n)
---
ReadBytesN(n)
---

=== write stdout bytes
import sys
def f(b: bytes) -> None:
    sys.stdout.buffer.write(b)
---
WriteOut(b)
---

=== write stderr bytes
import sys
def f(b: bytes) -> None:
    sys.stderr.buffer.write(b)
---
WriteErr(b)
---

=== sys argv
import sys
def f() -> list[str]:
    return sys.argv
---
Args()
---

=== argv element string comparison
import sys
def f() -> bool:
    args = sys.argv[1:]
    return args[0] == "--help"
---
== "--help"
---

=== argv slice-from-one is just Args
import sys
def f() -> int:
    return len(sys.argv[1:])
---
return Len(Args())
---

=== argv slice-from-two offsets by one
import sys
def f() -> list[str]:
    return sys.argv[2:]
---
Args()[1:
---

=== argv index offsets for program name
import sys
def f() -> str:
    return sys.argv[1]
---
return Args()[0]
---

=== argv length includes program name
import sys
def f() -> bool:
    return len(sys.argv) > 1
---
Len(Args()) + 1 > 1
---

=== getenv no default
import os
def f(name: str) -> str | None:
    return os.getenv(name)
---
GetEnv(name)
---

=== getenv with default
import os
def f(name: str) -> str:
    return os.getenv(name, "fallback")
---
GetEnv(name, "fallback")
---

=== with open read binary
def f(path: str) -> bytes:
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError:
        return b""
    return raw
---
ReadFile(path)
---

=== with open write text
def f(path: str, data: str) -> bool:
    try:
        with open(path, "w") as fh:
            fh.write(data)
    except OSError:
        return False
    return True
---
WriteFile(path, data)
---
