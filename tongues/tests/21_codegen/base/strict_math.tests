=== float mod by zero traps
@@["strict_math"]
fn Main() -> void {
    let caught: bool = false
    try {
        let x: float = 1.0 % 0.0
    } catch e {
        caught = true
    }
    WritelnOut(ToString(caught))
}

=== min with nan propagates
@@["strict_math"]
fn Main() -> void {
    let nan: float = 0.0 / 0.0
    let x: float = Min(nan, 1.0)
    WritelnOut(ToString(IsNaN(x)))
}

=== max with nan propagates
@@["strict_math"]
fn Main() -> void {
    let nan: float = 0.0 / 0.0
    let x: float = Max(nan, 1.0)
    WritelnOut(ToString(IsNaN(x)))
}

=== sorted with nan traps
@@["strict_math"]
fn Main() -> void {
    let nan: float = 0.0 / 0.0
    let caught: bool = false
    try {
        let xs: list[float] = Sorted([1.0, nan, 2.0])
    } catch e {
        caught = true
    }
    WritelnOut(ToString(caught))
}

=== non-strict ops unchanged
@@["strict_math"]
fn Main() -> void {
    let x: float = 1.5 + 2.5
    let y: int = 10 / 3
    let z: int = 10 % 3
    WritelnOut(ToString(y))
}
