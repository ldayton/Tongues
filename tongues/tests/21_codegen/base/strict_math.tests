=== checked left shift
@@["strict_math"]
fn Main() -> void {
    let x: int = 1
    let y: int = x << 4
    WritelnOut(ToString(y))
}

=== checked right shift
@@["strict_math"]
fn Main() -> void {
    let x: int = 256
    let y: int = x >> 4
    WritelnOut(ToString(y))
}

=== logical right shift
@@["strict_math"]
fn Main() -> void {
    let x: int = 0 - 1
    let y: int = x >>> 1
    WritelnOut(ToString(y))
}

=== wrapping add
@@["strict_math"]
fn Main() -> void {
    let a: int = 9223372036854775807
    let b: int = WrappingAdd(a, 1)
    WritelnOut(ToString(b))
}

=== wrapping sub
@@["strict_math"]
fn Main() -> void {
    let max: int = 9223372036854775807
    let min: int = 0 - max - 1
    let b: int = WrappingSub(min, 1)
    WritelnOut(ToString(b))
}

