=== checked int add
sub Main {
    my $a = 1;
    my $b = 2;
    my $c = checked_add_i64($a, $b);
    WritelnOut(ToString($c));
}

=== checked int sub
sub Main {
    my $a = 5;
    my $b = 3;
    my $c = checked_sub_i64($a, $b);
    WritelnOut(ToString($c));
}

=== checked int mul
sub Main {
    my $a = 3;
    my $b = 7;
    my $c = checked_mul_i64($a, $b);
    WritelnOut(ToString($c));
}

=== checked int negate
sub Main {
    my $x = 42;
    my $y = checked_neg_i64($x);
    WritelnOut(ToString($y));
}

=== checked left shift
sub Main {
    my $x = 1;
    my $y = checked_shl_i64($x, 4);
    WritelnOut(ToString($y));
}

=== checked right shift
sub Main {
    my $x = 256;
    my $y = checked_shr_i64($x, 4);
    WritelnOut(ToString($y));
}

=== logical right shift
sub Main {
    my $x = checked_sub_i64(0, 1);
    my $y = logical_shr_i64($x, 1);
    WritelnOut(ToString($y));
}

=== wrapping add
sub Main {
    my $a = 9223372036854775807;
    my $b = WrappingAdd($a, 1);
    WritelnOut(ToString($b));
}

=== wrapping sub
sub Main {
    my $max = 9223372036854775807;
    my $min = checked_sub_i64(checked_sub_i64(0, $max), 1);
    my $b = WrappingSub($min, 1);
    WritelnOut(ToString($b));
}

=== wrapping mul
sub Main {
    my $max = 9223372036854775807;
    my $b = WrappingMul($max, 2);
    WritelnOut(ToString($b));
}

