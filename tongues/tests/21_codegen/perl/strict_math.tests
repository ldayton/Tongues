=== float mod by zero traps
sub Main {
    my $caught = 0;
    eval {
        my $x = strict_fmod(1.0, 0.0);
        1;
    } or do {
        $caught = 1;
    };
    WritelnOut(ToString($caught));
}

=== min with nan propagates
sub Main {
    my $nan = 0.0 / 0.0;
    my $x = strict_min_f64($nan, 1.0);
    WritelnOut(ToString(IsNaN($x)));
}

=== max with nan propagates
sub Main {
    my $nan = 0.0 / 0.0;
    my $x = strict_max_f64($nan, 1.0);
    WritelnOut(ToString(IsNaN($x)));
}

=== sorted with nan traps
sub Main {
    my $nan = 0.0 / 0.0;
    my $caught = 0;
    eval {
        my $xs = strict_sorted_f64([1.0, $nan, 2.0]);
        1;
    } or do {
        $caught = 1;
    };
    WritelnOut(ToString($caught));
}

=== non-strict ops unchanged
sub Main {
    my $x = 1.5 + 2.5;
    my $y = checked_div_i64(10, 3);
    my $z = checked_rem_i64(10, 3);
    WritelnOut(ToString($y));
}
