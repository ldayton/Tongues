=== float mod by zero traps
caught: bool = False
try:
    x: float = strict_fmod(1.0, 0.0)
except Exception:
    caught = True
print(str(caught))

=== min with nan propagates
nan: float = float("nan")
x: float = strict_min_f64(nan, 1.0)
print(str(math.isnan(x)))

=== max with nan propagates
nan: float = float("nan")
x: float = strict_max_f64(nan, 1.0)
print(str(math.isnan(x)))

=== sorted with nan traps
nan: float = float("nan")
caught: bool = False
try:
    xs: list[float] = strict_sorted_f64([1.0, nan, 2.0])
except Exception:
    caught = True
print(str(caught))

=== non-strict ops unchanged
x: float = 1.5 + 2.5
y: int = checked_div_i64(10, 3)
z: int = checked_rem_i64(10, 3)
