let MAX_SIZE: int = 256
let GREETING: string = "hello"
let DEBUG: bool = false

struct Point {
    x: int
    y: int
}

let ORIGIN: Point = Point(0, 0)

fn MakeTable() -> list[int] {
    return [0, 1, 4, 9, 16]
}

let TABLE: list[int] = MakeTable()

let PI: float = 3.14159
let TAU: float = 6.28318
fn Main() -> void {
    Assert(MAX_SIZE == 256)
    Assert(GREETING == "hello")
    Assert(!DEBUG)
    Assert(ORIGIN.x == 0)
    Assert(ORIGIN.y == 0)
    Assert(Len(TABLE) == 5)
    Assert(TABLE[0] == 0)
    Assert(TABLE[1] == 1)
    Assert(TABLE[4] == 16)

    -- float comparisons on global lets (#122)
    Assert(PI > 3.0)
    Assert(PI < 4.0)
    Assert(TAU > PI)

    -- float arithmetic on global lets (#122)
    Assert(PI + PI > 6.28)
    Assert(TAU - PI > 3.14)
    Assert(PI * 2.0 > 6.28)

    -- int arithmetic on global lets (#122)
    Assert(MAX_SIZE + 1 == 257)
    Assert(MAX_SIZE * 2 == 512)
    Assert(MAX_SIZE - 6 == 250)

    -- negation on global let (#122)
    Assert(-PI < 0.0)

}
