=== valid: assert narrows optional to non-nil
fn Maybe() -> int? {
    return 42
}
fn Consume(x: int) -> void {
    WritelnOut(ToString(x))
}
fn Main() -> void {
    let x: int? = Maybe()
    Assert(x != nil)
    Consume(x)
}
---
ok
