=== valid: field narrowed after nil-guard ensure pattern
struct Token {
    value: int
}
struct Lexer {
    _cache: Token? = nil

    fn Next(this) -> Token {
        return Token(0)
    }

    fn Peek(this) -> Token {
        if IsNil(this._cache) {
            this._cache = this.Next()
        }
        return this._cache
    }
}
fn Main() -> void {
    let lex: Lexer = Lexer(nil)
    let t: Token = lex.Peek()
}
---
ok
---

=== valid: field narrowed after nil-guard ensure then access
struct Token {
    value: int
}
struct Lexer {
    _cache: Token? = nil

    fn Next(this) -> Token {
        return Token(0)
    }

    fn CachedValue(this) -> int {
        if IsNil(this._cache) {
            this._cache = this.Next()
        }
        return this._cache.value
    }
}
fn Main() -> void {
    let lex: Lexer = Lexer(nil)
    WritelnOut(ToString(lex.CachedValue()))
}
