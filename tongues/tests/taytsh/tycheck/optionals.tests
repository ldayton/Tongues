=== valid: reused optional local narrowed after reassignment
fn MaybeA() -> int? { return 42 }
fn MaybeB() -> int? { return nil }
fn Fetch() -> int {
    let v: int? = MaybeA()
    if v != nil {
        return v
    }
    v = MaybeB()
    if v != nil {
        return v
    }
    return 0
}
fn Main() -> void {
    WritelnOut(ToString(Fetch()))
}
---
ok
