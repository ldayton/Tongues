=== valid: assign nil to optional field after narrowing
struct Lexer {
    cache: int?

    fn Next(this) -> int {
        if this.cache != nil {
            let tok: int = this.cache
            this.cache = nil
            return tok
        }
        return 0
    }
}
fn Main() -> void {
    let lex: Lexer = Lexer(nil)
    let n: int = lex.Next()
}
---
ok
---

=== valid: return local assigned from narrowed optional field after nil-assign
struct Cache {
    val: int?
    last: int

    fn Pop(this) -> int {
        if this.val != nil {
            let v: int = this.val
            this.val = nil
            this.last = v
            return v
        }
        return 0
    }
}
fn Main() -> void {
    let c: Cache = Cache(42, 0)
    WritelnOut(ToString(c.Pop()))
}
---
ok
---

=== valid: return narrowed optional from non-Main function
fn Maybe() -> int? {
    return 42
}
fn Fetch() -> int {
    let tok: int? = Maybe()
    if tok != nil {
        return tok
    }
    return 0
}
fn Main() -> void {
    WritelnOut(ToString(Fetch()))
}
