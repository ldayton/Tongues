=== valid: field narrowed after nil-guard ensure then assign to local
struct Token {
    value: int
}
struct Lexer {
    _cache: Token? = nil

    fn Next(this) -> Token {
        return Token(0)
    }

    fn EnsureAndGet(this) -> Token {
        if IsNil(this._cache) {
            this._cache = this.Next()
        }
        let result: Token = this._cache
        return result
    }
}
fn Main() -> void {
    let lex: Lexer = Lexer(nil)
    let t: Token = lex.EnsureAndGet()
}
---
ok
