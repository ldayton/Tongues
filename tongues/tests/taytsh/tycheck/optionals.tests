=== valid: both branches narrow optional via assignment and guard
struct Foo {
    name: string
}
fn MaybeStr() -> string? { return "x" }
fn MakeStr() -> string { return "y" }
fn Main() -> void {
    let name: string? = nil
    if true {
        name = MakeStr()
    } else {
        name = MaybeStr()
        if name == nil { return }
    }
    reveal_type(name)
    let f: Foo = Foo(name)
}
---
