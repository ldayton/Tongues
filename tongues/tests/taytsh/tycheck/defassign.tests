=== valid: tuple assign initializes variables
struct Foo {
    x: int
}
fn MakePair() -> (Foo, Foo) {
    return (Foo(1), Foo(2))
}
fn Main() -> void {
    let a: Foo
    let b: Foo
    a, b = MakePair()
    let x: int = a.x
    let y: int = b.x
}
---
ok
---

