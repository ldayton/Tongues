=== IsType else branch keeps original type
interface Node {}
struct Lit : Node {
    value: int
}
struct BinOp : Node {
    op: string
}
fn Foo(n: Node) -> void {
    if IsType(n, "Lit") {
        let v: int = n.value
    } else {
        let v: int = n.value
    }
}
