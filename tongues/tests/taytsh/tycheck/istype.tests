=== IsType narrows field access path
interface Expr {}
struct Var : Expr {
    name: string
}
struct Call : Expr {
    func: Expr
}
fn Foo(c: Call) -> string {
    if IsType(c.func, "Var") {
        return c.func.name
    }
    return ""
}
fn Main() -> void {
}
