=== deep elif isinstance with fallthrough on each level
class A:
    a: int
class B:
    b: str
class C:
    c: float
class D:
    d: bool
def f(x: A | B | C | D) -> str:
    result: str = ""
    if isinstance(x, A):
        reveal_type(x)
        result = str(x.a)
    elif isinstance(x, B):
        reveal_type(x)
        result = x.b
    elif isinstance(x, C):
        reveal_type(x)
        result = str(x.c)
    else:
        reveal_type(x)
        result = str(x.d)
    return result
---
reveal:13 = A
reveal:16 = B
reveal:19 = C
reveal:22 = D
---

=== three guard types in single function
from dataclasses import dataclass
@dataclass
class Add:
    kind: str
    left: int
    right: int
@dataclass
class Mul:
    kind: str
    left: int
    right: int
def eval_safe(node: Add | Mul | None, default: int | None) -> int:
    if node is None:
        return 0
    if default is None:
        default = 0
    if node.kind == "add":
        return node.left + node.right + default
    return node.left * node.right + default
---
ok
---

