=== kind discrimination with early return pattern
class A:
    kind: str
    a_val: int
class B:
    kind: str
    b_val: str
class C:
    kind: str
    c_val: float
def f(x: A | B | C) -> str:
    if x.kind == "a":
        return str(x.a_val)
    if x.kind == "b":
        return x.b_val
    return str(x.c_val)
---
ok
---

=== narrowing with union of three including None
class A:
    a_val: int
class B:
    b_val: str
def f(x: A | B | None) -> str:
    if x is None:
        return "none"
    reveal_type(x)
    if isinstance(x, A):
        return str(x.a_val)
    reveal_type(x)
    return x.b_val
---
reveal:8 = A | B
reveal:11 = B
