=== narrowing across multiple early exits
class A:
    a_val: int
class B:
    b_val: str
class C:
    c_val: float
class D:
    d_val: bool
def f(x: A | B | C | D) -> float:
    if isinstance(x, A):
        return float(x.a_val)
    if isinstance(x, B):
        return float(len(x.b_val))
    if isinstance(x, C):
        return x.c_val
    reveal_type(x)
    if x.d_val:
        return 1.0
    return 0.0
---
reveal:17 = D
---

