    left: int
    right: int
@dataclass
class Sub:
    kind: str
    left: int
    right: int
@dataclass
class Neg:
    kind: str
    operand: int
def eval_expr(e: Add | Sub | Neg) -> int:
    if e.kind == "add":
        return e.left + e.right
    elif e.kind == "sub":
        return e.left - e.right
    return 0 - e.operand
