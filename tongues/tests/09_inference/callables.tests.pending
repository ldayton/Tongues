=== wrong arg type in nested call in return not allowed
def make_int(x: int) -> int:
    return x
def main() -> int:
    s: str = "x"
    return make_int(s) + 1
---
error: argument 1 has type str, expected int
---

=== wrong arg type in boolop call not allowed
def check(x: int) -> bool:
    return True
def main() -> int:
    s: str = "x"
    if True and check(s):
        return 1
    return 0
---
error: argument 1 has type str, expected int
