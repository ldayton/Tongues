=== kind discrimination with three variants
from dataclasses import dataclass
@dataclass
class Add:
    kind: str
    left: int
    right: int
@dataclass
class Sub:
    kind: str
    left: int
    right: int
@dataclass
class Mul:
    kind: str
    left: int
    right: int
def eval(node: Add | Sub | Mul) -> int:
    if node.kind == "add":
        return node.left + node.right
    elif node.kind == "sub":
        return node.left - node.right
    return node.left * node.right
---
ok
