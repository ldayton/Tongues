=== kind field discriminates union
from dataclasses import dataclass
@dataclass
class Add:
    kind: str
    left: int
    right: int
@dataclass
class Sub:
    kind: str
    left: int
    right: int
def eval(node: Add | Sub) -> int:
    if node.kind == "add":
        return node.left + node.right
    return node.left - node.right
---
