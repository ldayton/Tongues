=== isinstance then while narrows further
from dataclasses import dataclass
class Node:
    pass
@dataclass
class Chain(Node):
    value: int
    next: "Chain | None"
def f(n: Node) -> int:
    if not isinstance(n, Chain):
        return -1
    total: int = 0
    current: Chain | None = n
    while current is not None:
        total += current.value
        current = current.next
    return total
---
ok
