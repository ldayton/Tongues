=== isinstance on hierarchy with shared field
from dataclasses import dataclass
class Node:
    pass
@dataclass
class Leaf(Node):
    value: int
@dataclass
class Branch(Node):
    left: Node
    right: Node
def count(n: Node) -> int:
    if isinstance(n, Leaf):
        return 1
    if isinstance(n, Branch):
        return count(n.left) + count(n.right)
    return 0
