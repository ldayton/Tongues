=== isinstance narrows to subtype
class Animal:
    pass
class Dog(Animal):
    def bark(self) -> str:
        return "woof"
def f(a: Animal) -> str:
    if isinstance(a, Dog):
        return a.bark()
    return "unknown"
---
ok
---

