=== multiple functions preserve order
def first() -> int:
    return 1
def second() -> int:
    return 2
---
fn first() -> int {
    return 1
}
fn second() -> int {
    return 2
}
---

=== union of sibling classes resolves to hierarchy root
from dataclasses import dataclass
@dataclass
class Base:
    x: int
@dataclass
class A(Base):
    y: int
@dataclass
class B(Base):
    z: int
def f(val: A | B) -> int:
    return val.x
---
fn f(val: Base) -> int {
---

=== union resolves to nearest common ancestor not topmost root
from dataclasses import dataclass
@dataclass
class Root:
    x: int
@dataclass
class Middle(Root):
    y: int
@dataclass
class Left(Middle):
    a: int
@dataclass
class Right(Middle):
    b: int
def f(val: Left | Right) -> int:
    return val.y
---
fn f(val: Middle) -> int {
---

=== error: base class with subclasses constructed directly
from dataclasses import dataclass
@dataclass
class Type:
    kind: str
@dataclass
class ListT(Type):
    element: Type
INT_T: Type = Type(kind="int")
def f() -> Type:
    return INT_T
---
error: cannot construct interface
---

=== error function with non-zero default parameter value
def decode(s: str, strict: bool = True) -> str:
    return s
---
error: non-zero default parameter value
---

=== error method with non-zero default parameter value
from dataclasses import dataclass
@dataclass
class Codec:
    name: str
    def decode(self, s: str, strict: bool = True) -> str:
        return s
def f() -> None:
    c = Codec("utf8")
    _ = c.decode("")
---
error: non-zero default parameter value
---

=== error constructor too few arguments
from dataclasses import dataclass
@dataclass
class Point:
    x: int
    y: int
    z: int
def f() -> Point:
    return Point(1, 2)
---
error: constructor arity
---

=== error constructor too many arguments
from dataclasses import dataclass
@dataclass
class Word:
    text: str
def f() -> Word:
    return Word("hi", "extra")
---
error: constructor arity
---

=== ok constructor with default parameter omitted
from dataclasses import dataclass
@dataclass
class Config:
    host: str
    port: int = 8080
def f() -> Config:
    return Config("localhost")
---
---

=== ok mixed positional and keyword args in constructor
from dataclasses import dataclass
@dataclass
class Config:
    host: str
    port: int = 8080
    debug: bool = False
def f() -> Config:
    return Config("localhost", debug=True)
---
return Config(host: "localhost", debug: True)
---

