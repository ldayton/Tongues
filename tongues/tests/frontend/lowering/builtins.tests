=== len of list
def f(xs: list[int]) -> int:
    return len(xs)
---
return Len(xs)
---

=== len of string
def f(s: str) -> int:
    return len(s)
---
return Len(s)
---

=== min two args
def f(a: int, b: int) -> int:
    return min(a, b)
---
Min(a, b)
---

=== max two args
def f(a: int, b: int) -> int:
    return max(a, b)
---
Max(a, b)
---

=== abs
def f(x: int) -> int:
    return abs(x)
---
Abs(x)
---

=== int from string
def f(s: str) -> int:
    return int(s)
---
ParseInt(s, 10)
---

=== int with base
def f(s: str) -> int:
    return int(s, 16)
---
ParseInt(s, 16)
---

=== float from string
def f(s: str) -> float:
    return float(s)
---
ParseFloat(s)
---

=== str from int
def f(n: int) -> str:
    return str(n)
---
ToString(n)
---

=== chr builtin
def f(n: int) -> str:
    return chr(n)
---
RuneFromInt(n)
---

=== ord builtin
def f(c: str) -> int:
    return ord(c)
---
RuneToInt(c[0])
---

=== sorted list
def f(xs: list[int]) -> list[int]:
    return sorted(xs)
---
Sorted(xs)
---

=== sorted reversed
def f(xs: list[int]) -> list[int]:
    return sorted(xs, reverse=True)
---
Reversed(Sorted(xs))
---

=== sorted with key lambda
def f(xs: list[int]) -> list[int]:
    return sorted(xs, key=lambda x: -x)
---
Sorted(xs, (x: int) -> int => -x)
---

=== sorted with key and reverse
def f(xs: list[str]) -> list[str]:
    return sorted(xs, key=len, reverse=True)
---
Reversed(Sorted(xs, (s: string) -> int => Len(s)))
---

=== min with key lambda
def f(xs: list[tuple[str, int]]) -> tuple[str, int]:
    return min(xs, key=lambda t: t[1])
---
Min(xs, (t: (string, int)) -> int => t.1)
---

=== max with key lambda
def f(xs: list[str]) -> str:
    return max(xs, key=lambda s: len(s))
---
Max(xs, (s: string) -> int => Len(s))
---

=== lambda in callable param
from typing import Callable
def apply(f: Callable[[int], int], x: int) -> int:
    return f(x)
def g() -> int:
    return apply(lambda x: x + 1, 5)
---
apply((x: int) -> int => x + 1, 5)
---

=== lambda in return position
from typing import Callable
def g() -> Callable[[int], int]:
    return lambda x: x + 1
---
return (x: int) -> int => x + 1
---

=== lambda assigned to variable
from typing import Callable
def g() -> int:
    f: Callable[[int], int] = lambda x: x + 1
    return f(5)
---
(x: int) -> int => x + 1
---

=== nullary lambda
from typing import Callable
def apply(f: Callable[[], int]) -> int:
    return f()
def g() -> int:
    return apply(lambda: 42)
---
apply(() -> int => 42)
---

=== multi-param lambda
from typing import Callable
def apply(f: Callable[[int, str], bool]) -> bool:
    return f(1, "a")
def g() -> bool:
    return apply(lambda x, s: len(s) > x)
---
apply((x: int, s: string) -> bool => Len(s) > x)
---

=== sorted with key named function
def get_len(s: str) -> int:
    return len(s)
def f(xs: list[str]) -> list[str]:
    return sorted(xs, key=get_len)
---
Sorted(xs, (s: string) -> int => Len(s))
---

=== bool from int
def f(n: int) -> bool:
    return bool(n)
---
n != 0
---

=== assert_never after exhaustive isinstance
from typing import assert_never
from dataclasses import dataclass
@dataclass
class A:
    a_val: int
@dataclass
class B:
    b_val: str
def f(x: A | B) -> int:
    if isinstance(x, A):
        return x.a_val
    if isinstance(x, B):
        return 0
    assert_never(x)
---
throw RuntimeError("unreachable")
---

=== isinstance
class Node:
    def __init__(self) -> None:
        pass
class Leaf(Node):
    def __init__(self, val: int) -> None:
        self.val = val
def f(n: Node) -> bool:
    return isinstance(n, Leaf)
---
Leaf
---

=== isinstance with tuple of types
from dataclasses import dataclass
@dataclass
class A:
    x: int
@dataclass
class B:
    y: str
@dataclass
class C:
    z: float
def f(v: A | B | C) -> bool:
    return isinstance(v, (A, B))
---
IsType(v, "A") || IsType(v, "B")
---

