=== optional annotated with method call value
class Foo:
    def __init__(self) -> None:
        self.data: dict[str, str] = {}
def f(obj: Foo) -> str:
    val: str | None = obj.data.get("key")
    if val is None:
        return ""
    return val
---
let val: string? = Get(obj.data, "key")
---

=== hoisted bytes variable gets correct zero value
def encode_codepoint(cp: int) -> bytes:
    return b""
def f(codepoints: list[int]) -> None:
    i: int = 0
    while i < len(codepoints):
        chunk: bytes = encode_codepoint(codepoints[i])
        i += 1
---
let chunk: bytes = b""
---

