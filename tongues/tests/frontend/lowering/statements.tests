=== raise exception
class MyError(Exception):
    def __init__(self, msg: str) -> None:
        self.msg = msg
def f() -> None:
    raise MyError("fail")
---
throw MyError("fail")
---

=== assert no message
def f(x: int) -> None:
    assert x > 0
---
Assert(x > 0)
---

=== assert with message
def f(x: int) -> None:
    assert x > 0, "must be positive"
---
Assert(x > 0, "must be positive")
---

=== print
def f() -> None:
    print("hello")
