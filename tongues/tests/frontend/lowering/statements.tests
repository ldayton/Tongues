=== return literal
def f() -> int:
    return 42
---
return 42
---

=== variable declaration inferred
def f() -> int:
    x = 10
    return x
---
let x: int = 10
---

=== annotated declaration
def f() -> None:
    x: int = 10
    _ = x
---
let x: int = 10
---

=== augmented assignment
def f() -> None:
    x = 0
    x += 1
---
x += 1
---

=== if statement
def f(x: int) -> str:
    if x > 0:
        return "pos"
    return "other"
---
if x > 0 {
    return "pos"
}
---

=== if else
def f(x: int) -> str:
    if x > 0:
        return "pos"
    else:
        return "neg"
---
if x > 0 {
    return "pos"
} else {
    return "neg"
}
---

=== while loop
def f() -> int:
    n = 10
    while n > 0:
        n -= 1
    return n
---
while n > 0 {
    n -= 1
}
---

