=== hoisted string iteration var is string not rune union
from dataclasses import dataclass
@dataclass
class Lexer:
    source: str
    pos: int
    length: int
    def advance(self) -> str:
        c = self.source[self.pos]
        self.pos += 1
        return c
    def parse(self) -> list[str]:
        chars: list[str] = []
        flag: bool = False
        while self.pos < self.length:
            if flag:
                line: str = "x"
                for ch in line:
                    chars.append(ch)
                continue
            ch = self.advance()
            chars.append(ch)
        return chars
---
let ch: string
