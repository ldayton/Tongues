=== match on field access narrows subject
from dataclasses import dataclass
class Pattern:
    pass
@dataclass
class PatternType(Pattern):
    name: str
@dataclass
class PatternEnum(Pattern):
    variant: str
@dataclass
class Case:
    pattern: Pattern
def f(c: Case) -> str:
    match c.pattern:
        case PatternType():
            return c.pattern.name
        case PatternEnum():
            return c.pattern.variant
    return ""
---
ok
---

=== match on field access with or pattern narrows subject
from dataclasses import dataclass
class Expr:
    pass
@dataclass
class IntLit(Expr):
    value: int
@dataclass
class FloatLit(Expr):
    value: int
@dataclass
class StrLit(Expr):
    text: str
@dataclass
class Stmt:
    expr: Expr
def f(s: Stmt) -> int:
    match s.expr:
        case IntLit() | FloatLit():
            return s.expr.value
        case StrLit():
            return len(s.expr.text)
    return 0
---
ok
---

=== match narrows remainder after case on union
from dataclasses import dataclass
@dataclass
class A:
    a_val: int
@dataclass
class B:
    b_val: str
@dataclass
class C:
    c_val: float
def f(x: A | B | C) -> str:
    match x:
        case A():
            return "a"
        case B():
            reveal_type(x)
    return ""
---
reveal:16 = B
---

=== match narrows remainder across multiple cases on union
from dataclasses import dataclass
@dataclass
class A:
    a_val: int
@dataclass
class B:
    b_val: str
@dataclass
class C:
    c_val: float
def f(x: A | B | C) -> None:
    match x:
        case A():
            pass
        case B():
            pass
        case _:
            reveal_type(x)
