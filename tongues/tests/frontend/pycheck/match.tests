=== match on method result does not narrow
from dataclasses import dataclass
class Animal:
    pass
@dataclass
class Dog(Animal):
    bark_sound: str
@dataclass
class Cat(Animal):
    purr_sound: str
class Box:
    def get(self) -> Animal:
        return Dog(bark_sound="woof")
def f(b: Box) -> str:
    match b.get():
        case Dog():
            return "dog"
    return "other"
---
ok
