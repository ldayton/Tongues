=== bool plus int coerces to int
def f() -> int:
    return True + 1
---
ok
---

=== bool in arithmetic yields int
def f(x: bool) -> int:
    return x + 1
---
ok
---

=== bool minus bool yields int
def f() -> int:
    return True - False
---
ok
---

=== unary minus on bool yields int
def f() -> int:
    return -True
---
ok
---

=== bool bitwise and preserves bool
def f() -> bool:
    return True & False
---
ok
---

=== mixed bool int bitwise yields int
def f() -> int:
    return True & 1
---
ok
---

=== min with mixed bool and int yields int
def f() -> int:
    return min(True, 1)
---
ok
---

=== max with mixed bool and int yields int
def f() -> int:
    return max(False, 0)
---
ok
---

=== large integer literal allowed
def f() -> int:
    x: int = 9007199254740992
    return x
---
ok
---

=== bool compared to int allowed
def f(x: bool) -> bool:
    return x == 1
---
ok
---

=== string index returns str
def f(s: str) -> str:
    return s[0]
---
ok
---

=== bool multiply yields int
def f(x: bool) -> int:
    return x * 5
---
ok
---

=== int plus float yields float
def f() -> float:
    return 1 + 3.14
---
ok
---

=== bool or in arithmetic context
def f() -> int:
    x: bool = True
    y: bool = False
    return x + y
---
ok
---

=== byte widens to int in assignment
def f(data: bytes) -> None:
    for b in data:
        x: int = b
---
ok
---

=== byte in int arithmetic
def f(data: bytes) -> int:
    total: int = 0
    for b in data:
        total += b
    return total
---
ok
---

=== byte returned as int
def f(data: bytes) -> int:
    for b in data:
        return b
    return 0
---
ok
---

=== byte in bitwise with int
def f(data: bytes) -> int:
    for b in data:
        return b ^ 0xFF
    return 0
---
ok
---

=== byte compared to int literal
def f(data: bytes) -> bool:
    for b in data:
        if b == 255:
            return True
    return False
---
ok
---

=== byte passed to int parameter
def g(x: int) -> int:
    return x * 2
def f(data: bytes) -> int:
    for b in data:
        return g(b)
    return 0
---
ok
---
