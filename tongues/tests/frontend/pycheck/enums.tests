=== StrEnum as dataclass field
from dataclasses import dataclass
from enum import StrEnum
class Color(StrEnum):
    RED = "red"
    GREEN = "green"
@dataclass
class Shirt:
    color: Color
    size: int
def f() -> Shirt:
    return Shirt(Color.RED, 10)
---
ok
---

=== error: assign str to StrEnum
from enum import StrEnum
class Color(StrEnum):
    RED = "red"
    GREEN = "green"
def f() -> Color:
    c: Color = "red"
    return c
---
error: cannot assign
---

=== error: assign int to IntEnum
from enum import IntEnum
class Priority(IntEnum):
    LOW = 0
    HIGH = 1
def f() -> Priority:
    p: Priority = 0
    return p
---
error: cannot assign
---

=== error: assign wrong enum type
from enum import StrEnum
class Color(StrEnum):
    RED = "red"
class Size(StrEnum):
    SMALL = "small"
def f() -> Color:
    c: Color = Size.SMALL
    return c
---
error: cannot assign
---

=== error: ordering on StrEnum
from enum import StrEnum
class Color(StrEnum):
    RED = "red"
    GREEN = "green"
def f() -> bool:
    return Color.RED < Color.GREEN
---
error: not defined for enum
