=== StrEnum match with default
from enum import StrEnum
class Color(StrEnum):
    RED = "red"
    GREEN = "green"
    BLUE = "blue"
def describe(c: Color) -> str:
    match c:
        case Color.RED:
            return "red"
        case _:
            return "other"
---
ok
---

