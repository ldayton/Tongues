=== sorted key lambda with attribute access
class Item:
    def __init__(self) -> None:
        self.name: str = ""
def f(xs: list[Item]) -> list[Item]:
    return sorted(xs, key=lambda x: x.name)
---
ok
---

=== sorted key lambda with negation
def f(xs: list[int]) -> list[int]:
    return sorted(xs, key=lambda x: -x)
---
ok
---

=== min key lambda with tuple subscript
def f(xs: list[tuple[str, int]]) -> tuple[str, int]:
    return min(xs, key=lambda t: t[1])
---
ok
---

=== max key lambda with len
def f(xs: list[str]) -> str:
    return max(xs, key=lambda s: len(s))
---
ok
---

=== sorted key lambda accesses nonexistent attribute
class Item:
    def __init__(self) -> None:
        self.name: str = ""
def f(xs: list[Item]) -> list[Item]:
    return sorted(xs, key=lambda x: x.missing)
---
error: cannot access 'missing' on Item
---

=== lambda in callable param
from typing import Callable
def apply(f: Callable[[int], int], x: int) -> int:
    return f(x)
def g() -> int:
    return apply(lambda x: x + 1, 5)
---
ok
---

=== lambda in callable param with attribute access
from typing import Callable
class Item:
    def __init__(self) -> None:
        self.name: str = ""
def extract(f: Callable[[Item], str], item: Item) -> str:
    return f(item)
def g(item: Item) -> str:
    return extract(lambda x: x.name, item)
---
ok
---

=== lambda param count mismatch
from typing import Callable
def apply(f: Callable[[int, str], bool], x: int) -> bool:
    return f(x, "a")
def g() -> bool:
    return apply(lambda x: True, 1)
---
error: lambda has 1 parameters, expected 2
---

=== lambda body return type mismatch
from typing import Callable
def apply(f: Callable[[int], str]) -> str:
    return f(1)
def g() -> str:
    return apply(lambda x: 42)
---
error: lambda return type int not assignable to str
---

=== lambda body accesses nonexistent attribute
from typing import Callable
class Item:
    def __init__(self) -> None:
        self.name: str = ""
def apply(f: Callable[[Item], str]) -> str:
    return f(Item())
def g() -> str:
    return apply(lambda x: x.missing)
---
error: cannot access 'missing' on Item
---

=== lambda assigned to typed variable
from typing import Callable
def g() -> int:
    f: Callable[[int], int] = lambda x: x + 1
    return f(5)
---
ok
---

=== lambda assigned to variable with wrong return type
from typing import Callable
def g() -> int:
    f: Callable[[int], str] = lambda x: x + 1
    return f(5)
---
error: lambda return type int not assignable to str
---

=== lambda assigned to non-callable type
def g() -> int:
    f: int = lambda x: x + 1
    return f
---
error: lambda
---

=== lambda in return position
from typing import Callable
def g() -> Callable[[int], int]:
    return lambda x: x + 1
---
ok
---

=== lambda in return position with wrong type
from typing import Callable
def g() -> Callable[[int], str]:
    return lambda x: x + 1
---
error: lambda return type int not assignable to str
---

=== lambda in return with wrong param count
from typing import Callable
def g() -> Callable[[int, str], bool]:
    return lambda x: True
---
error: lambda has 1 parameters, expected 2
---

=== nullary lambda
from typing import Callable
def apply(f: Callable[[], int]) -> int:
    return f()
def g() -> int:
    return apply(lambda: 42)
---
ok
---

=== multi-param lambda
from typing import Callable
def apply(f: Callable[[int, str], bool], x: int, s: str) -> bool:
    return f(x, s)
def g() -> bool:
    return apply(lambda x, s: len(s) > x, 3, "hello")
---
ok
---

=== lambda capturing outer variable in return
from typing import Callable
def g(y: int) -> Callable[[int], int]:
    return lambda x: x + y
---
error: lambda cannot capture variable 'y'
---

=== lambda capturing outer variable in assignment
from typing import Callable
def g(y: int) -> int:
    f: Callable[[int], int] = lambda x: x + y
    return f(1)
---
error: lambda cannot capture variable 'y'
---

=== lambda capturing variable in subexpression
from typing import Callable
def g(y: int) -> Callable[[int], int]:
    return lambda x: x + y * 2
---
error: lambda cannot capture variable 'y'
---

=== lambda capturing multiple variables
from typing import Callable
def g(a: int, b: int) -> Callable[[int], int]:
    return lambda x: a + x + b
---
error: lambda cannot capture variable 'a'
---

=== lambda capturing variable via attribute access
from typing import Callable
class Item:
    def __init__(self) -> None:
        self.value: int = 0
def g(item: Item) -> Callable[[], int]:
    return lambda: item.value
---
error: lambda cannot capture variable 'item'
---

=== lambda capturing variable in ternary
from typing import Callable
def g(y: int) -> Callable[[int], int]:
    return lambda x: y if x > 0 else x
---
error: lambda cannot capture variable 'y'
---

=== lambda calling builtin is ok
from typing import Callable
def g() -> Callable[[str], int]:
    return lambda s: len(s)
---
ok
---

=== lambda calling user function is ok
from typing import Callable
def helper(x: int) -> int:
    return x + 1
def g() -> Callable[[int], int]:
    return lambda x: helper(x)
---
ok
---

=== lambda referencing class is ok
from typing import Callable
class Pair:
    def __init__(self) -> None:
        self.x: int = 0
def g() -> Callable[[Pair], int]:
    return lambda p: p.x
---
ok
---

=== lambda with no captures is ok
from typing import Callable
def g() -> Callable[[int, int], int]:
    return lambda x, y: x + y
---
ok
---
