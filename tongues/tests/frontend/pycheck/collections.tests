=== list of union type accepts elements from both branches
class Decl:
    pass
class Stmt:
    pass
class FnDecl(Decl):
    pass
class LetStmt(Stmt):
    pass
def f() -> list[Decl | Stmt]:
    xs: list[Decl | Stmt] = []
    xs.append(FnDecl())
    xs.append(LetStmt())
    return xs
---
ok
---

=== subclass list assignable to union list
class Decl:
    pass
class Stmt:
    pass
class LetStmt(Stmt):
    pass
def make() -> list[LetStmt]:
    return [LetStmt()]
def f() -> list[Decl | Stmt]:
    result: list[Decl | Stmt] = []
    items: list[LetStmt] = make()
    i: int = 0
    while i < len(items):
        result.append(items[i])
        i += 1
    return result
---
ok
---

