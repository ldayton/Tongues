=== list comprehension widens to annotation type
class Val:
    pass
class VInt(Val):
    def __init__(self, v: int) -> None:
        self.v = v
def f(n: int) -> list[Val]:
    result: list[Val] = [VInt(x) for x in range(n)]
    return result
---
ok
---

