=== type alias with list
type Items = list[int]
def f(x: Items) -> Items:
    return x
---
ok
---

=== type alias with tuple
type Pair = tuple[str, int]
def f() -> Pair:
    return ("hi", 1)
---
ok
---

=== type alias with union
type Result = int | str
def f(x: Result) -> Result:
    return x
---
ok
