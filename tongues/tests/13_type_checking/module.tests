=== interface with method on struct
interface Shape {}
struct Circle : Shape {
    radius: float
    fn Area(this) -> float {
        return this.radius * this.radius
    }
}
fn Main() -> void {
    let c: Circle = Circle(IntToFloat(5))
    let a: float = c.Area()
}
