    return x * 2
}
fn Main() -> void {
    let f: fn[int, int] = Double
    let y: int = f(21)
}
---
ok
---

=== recursive function
fn Fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return Fib(n - 1) + Fib(n - 2)
}
fn Main() -> void {
    let x: int = Fib(10)
}
---
ok
---

=== mutually recursive functions
fn IsEven(n: int) -> bool {
    if n == 0 {
        return true
    }
    return IsOdd(n - 1)
}
fn IsOdd(n: int) -> bool {
    if n == 0 {
        return false
    }
    return IsEven(n - 1)
}
fn Main() -> void {
    let b: bool = IsEven(4)
}
---
ok
---

=== higher order function
fn Apply(f: fn[int, int], x: int) -> int {
    return f(x)
}
fn Double(x: int) -> int {
    return x * 2
}
fn Main() -> void {
    let result: int = Apply(Double, 21)
}
---
ok
