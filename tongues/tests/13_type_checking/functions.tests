ok
---

=== arity mismatch too many
fn Add(a: int, b: int) -> int {
    return a + b
}
fn Main() -> void {
    let x: int = Add(1, 2, 3)
}
---
error: expected 2 arguments, got 3
---

=== arity mismatch too few
fn Add(a: int, b: int) -> int {
    return a + b
}
fn Main() -> void {
    let x: int = Add(1)
}
---
error: expected 2 arguments, got 1
---

=== argument type mismatch
