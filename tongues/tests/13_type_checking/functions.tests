=== method calls another method on self
struct Calc {
    value: int
    fn Double(self) -> int {
        return self.value * 2
    }
    fn DoublePlus(self, n: int) -> int {
        return self.Double() + n
    }
}
fn Main() -> void {
    let c: Calc = Calc(5)
    let r: int = c.DoublePlus(3)
}
