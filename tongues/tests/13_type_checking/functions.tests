---

=== function literal expression body
fn Apply(xs: list[int], f: fn[int, int]) -> list[int] {
    let result: list[int]
    for x in xs {
        Append(result, f(x))
    }
    return result
}
fn Main() -> void {
    let xs: list[int] = [1, 2, 3]
    let doubled: list[int] = Apply(xs, (x: int) -> int => x * 2)
}
---
ok
---

=== function literal block body
fn Main() -> void {
    let f: fn[int, int] = (x: int) -> int {
        return x * 2
    }
    let y: int = f(21)
}
