=== match enum with default
enum Color {
    Red
    Green
    Blue
}
fn IsRed(c: Color) -> bool {
    match c {
        case Color.Red {
            return true
        }
        default {
            return false
        }
    }
}
fn Main() -> void {
    WritelnOut(ToString(IsRed(Color.Red)))
}
---
ok
