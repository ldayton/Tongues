=== match interface exhaustive
interface Node {}
struct Literal : Node {
    value: int
}
struct BinOp : Node {
    op: string
    left: Node
    right: Node
}
fn Eval(n: Node) -> int {
    match n {
        case lit: Literal {
            return lit.value
        }
        case bin: BinOp {
            return Eval(bin.left) + Eval(bin.right)
        }
    }
}
fn Main() -> void {
    let n: Node = Literal(42)
    WritelnOut(ToString(Eval(n)))
}
---
ok
---

=== match enum exhaustive
enum Color {
    Red
    Green
    Blue
}
fn Name(c: Color) -> string {
    match c {
        case Color.Red {
            return "red"
        }
        case Color.Green {
            return "green"
        }
        case Color.Blue {
            return "blue"
        }
    }
}
fn Main() -> void {
    WritelnOut(Name(Color.Red))
}
---
ok
