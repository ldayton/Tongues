=== interface used in recursive struct
interface Expr {}
struct Lit : Expr {
    value: int
}
struct BinOp : Expr {
    left: Expr
    right: Expr
}
fn Eval(e: Expr) -> int {
    match e {
        case lit: Lit {
            return lit.value
        }
        case bin: BinOp {
            return Eval(bin.left) + Eval(bin.right)
        }
    }
}
fn Main() -> void {
    let e: Expr = BinOp(Lit(1), Lit(2))
    WritelnOut(ToString(Eval(e)))
}
---
ok
---

