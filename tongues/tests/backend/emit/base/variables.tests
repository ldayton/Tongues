=== module-level constant
GREETING: str = "hello"
def main() -> None:
    x: str = GREETING
    print(x)
if __name__ == "__main__":
    main()

=== module-level frozenset constant
WORDS: set[str] = frozenset({"hello", "world"})
def main() -> None:
    x: bool = "hello" in WORDS
    print(str(x))
if __name__ == "__main__":
    main()

=== module-level struct instance (hierarchy root)
class Kind:
    tag: str
class SubKind(Kind):
    value: int
DEFAULT_KIND: Kind = SubKind(tag="base", value=0)
def main() -> None:
    x: str = DEFAULT_KIND.tag
    print(x)
if __name__ == "__main__":
    main()

=== underscore-prefixed constant distinct from non-prefixed
ITEMS: set[str] = frozenset({"a", "b"})
_ITEMS: set[str] = frozenset({"c", "d"})
def main() -> None:
    x: bool = "a" in ITEMS
    y: bool = "c" in _ITEMS
    print(str(x) + str(y))
if __name__ == "__main__":
    main()

=== enum constant stays uppercase at module level
class TokenType:
    EOF: int = 0
    WORD: int = 1
def main() -> None:
    t: int = TokenType.EOF
    print(str(t))
if __name__ == "__main__":
    main()
