=== bitwise and with comparison
def main() -> None:
    flags: int = 6
    flag: int = 2
    print(flags & flag != 0)
if __name__ == "__main__":
    main()

=== divmod negative floor semantics
def main() -> None:
    q, r = divmod(-10, 3)
    print(str(q))
    print(str(r))
if __name__ == "__main__":
    main()
