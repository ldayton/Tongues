=== isinstance check
import sys
class Animal:
    name: str
class Dog(Animal):
    breed: str
def main() -> None:
    d: Dog = Dog(name="Rex", breed="Lab")
    a: Animal = d
    if isinstance(a, Dog):
        print("yes")
if __name__ == "__main__":
    main()

=== isinstance with tuple of types
import sys
class Animal:
    name: str
class Dog(Animal):
    breed: str
class Cat(Animal):
    color: str
def check(a: Animal) -> bool:
    return isinstance(a, (Dog, Cat))
def main() -> None:
    d: Dog = Dog(name="Rex", breed="Lab")
    if check(d):
        print("yes")
if __name__ == "__main__":
    main()

=== isinstance with str
def main() -> None:
    x: str = "hello"
    if isinstance(x, str):
        print("yes")
if __name__ == "__main__":
    main()

=== isinstance with int
def main() -> None:
    x: int = 42
    if isinstance(x, int):
        print("yes")
if __name__ == "__main__":
    main()

=== isinstance user class shadows builtin name
import sys
class List:
    items: str
def check(x: List) -> bool:
    return isinstance(x, List)
def main() -> None:
    v: List = List(items="a,b,c")
    if check(v):
        print("yes")
if __name__ == "__main__":
    main()
