=== struct field with struct default
import sys
class Inner:
    value: str
class Outer:
    name: str
    def __init__(self, name: str):
        self.name: str = name
        self.inner: Inner = Inner(value="ok")
def main() -> None:
    o: Outer = Outer(name="test")
    print(o.inner.value)
if __name__ == "__main__":
    main()

=== computed field not in constructor params
import sys
class Wrapper:
    def __init__(self, text: str) -> None:
        self.text = text
        self.length: int = len(text)
def main() -> None:
    w: Wrapper = Wrapper(text="hello")
    print(w.length)
if __name__ == "__main__":
    main()

=== const kind field uses correct value
import sys
class MyNode:
    def __init__(self, value: int) -> None:
        self.kind = "my-node"
        self.value = value
def main() -> None:
    n: MyNode = MyNode(value=42)
    print(n.kind)
if __name__ == "__main__":
    main()

=== computed field references renamed param
import sys
class Builder:
    def __init__(self, prefix: str) -> None:
        self._prefix = prefix
        self._label: str = prefix.upper()
def main() -> None:
    b: Builder = Builder("test")
    print(b._label)
if __name__ == "__main__":
    main()

=== post-assignment nested field set in init
import sys
class Child:
    value: str
    _parent: str
class Parent:
    def __init__(self, name: str) -> None:
        self.name = name
        self.child: Child = Child(value="ok")
        self.child._parent = name
def main() -> None:
    p: Parent = Parent(name="test")
    print(p.child._parent)
if __name__ == "__main__":
    main()

=== error class with const kind field
import sys
class CompileError(Exception):
    def __init__(self, msg: str) -> None:
        self.kind = "compile"
        self.msg = msg
def main() -> None:
    try:
        raise CompileError("bad syntax")
    except CompileError as e:
        print(e.kind)
if __name__ == "__main__":
    main()
