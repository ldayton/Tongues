=== method with default bool param
import sys
class Parser:
    text: str
    def __init__(self, text: str):
        self.text: str = text
    def parse(self, strict: bool = False) -> str:
        if strict:
            return self.text.upper()
        return self.text
def main() -> None:
    p: Parser = Parser(text=sys.argv[1])
    result: str = p.parse()
    print(result)
if __name__ == "__main__":
    main()

=== class-level dict field default preserved
import sys
class TokenType:
    IF: int = 0
    THEN: int = 1
    ELSE: int = 2
class Lexer:
    source: str
    KEYWORDS: dict[str, int] = {
        "if": TokenType.IF,
        "then": TokenType.THEN,
        "else": TokenType.ELSE,
    }
    def __init__(self, source: str) -> None:
        self.source = source
    def is_keyword(self, word: str) -> bool:
        return word in self.KEYWORDS
def main() -> None:
    lex: Lexer = Lexer(source="if then else")
    print(str(lex.is_keyword("if")))
    print(str(lex.is_keyword("foo")))
if __name__ == "__main__":
    main()
