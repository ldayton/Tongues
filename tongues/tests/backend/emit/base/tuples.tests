=== tuple assign in if-body used after
def get_pair() -> tuple[str, int]:
    return ("hello", 0)
def main() -> None:
    a: str = ""
    b: int = 0
    if len("x") > 0:
        a, b = get_pair()
    print(a)
    print(str(b))
if __name__ == "__main__":
    main()

=== tuple unpack with discard
def get_pair() -> tuple[str, int]:
    return ("hello", 42)
def main() -> None:
    x, _ = get_pair()
    print(x)
if __name__ == "__main__":
    main()

=== tuple element with optional type
import sys
class Node:
    value: int
def find(xs: list[Node], key: int) -> tuple[Node | None, int]:
    return (None, -1)
def main() -> None:
    result: tuple[Node | None, int] = find([], 0)
    node: Node | None = result[0]
    idx: int = result[1]
    print(str(idx))
    if node is not None:
        print(str(node.value))
if __name__ == "__main__":
    main()

=== tuple assign in if-body one target used after
def get_pair() -> tuple[str, int]:
    return ("hello", 0)
def main() -> None:
    a: str = ""
    b: int = 0
    if len("x") > 0:
        a, b = get_pair()
    print(a)
if __name__ == "__main__":
    main()
