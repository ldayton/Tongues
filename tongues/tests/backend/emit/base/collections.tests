=== set from dict items
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2}
    s: set[tuple[str, int]] = set(d.items())
    print(str(len(s)))
if __name__ == "__main__":
    main()

=== list from dict
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
    ks: list[str] = list(d)
    print(str(len(ks)))
if __name__ == "__main__":
    main()

=== set from dict
