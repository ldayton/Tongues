=== list from dict keys method
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
    ks: list[str] = list(d.keys())
    print(str(len(ks)))
if __name__ == "__main__":
    main()

=== set from dict keys method
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
    s: set[str] = set(d.keys())
    print(str(len(s)))
if __name__ == "__main__":
    main()

=== star unpack two lists
def main() -> None:
    a: list[int] = [1, 2]
    b: list[int] = [3, 4]
    c: list[int] = [*a, *b]
    print(str(len(c)))
if __name__ == "__main__":
    main()

=== star unpack element then starred
def main() -> None:
    x: int = 1
    rest: list[int] = [2, 3]
    c: list[int] = [x, *rest]
    print(str(len(c)))
if __name__ == "__main__":
    main()

=== star unpack starred then element
def main() -> None:
    xs: list[int] = [1, 2]
    y: int = 3
    c: list[int] = [*xs, y]
    print(str(len(c)))
if __name__ == "__main__":
    main()

=== star unpack element starred element
def main() -> None:
    x: int = 1
    middle: list[int] = [2, 3]
    y: int = 4
    c: list[int] = [x, *middle, y]
    print(str(len(c)))
if __name__ == "__main__":
    main()

=== reversed list for loop
def main() -> None:
    xs: list[int] = [1, 2, 3]
    for x in reversed(xs):
        print(str(x))
if __name__ == "__main__":
    main()

=== reversed range for loop
def main() -> None:
    for i in reversed(range(5)):
        print(str(i))
if __name__ == "__main__":
    main()

=== reversed range with arithmetic start
def main() -> None:
    xs: list[int] = [1, 2, 3, 4, 5]
    for i in range(len(xs) - 1, -1, -1):
        print(str(xs[i]))
if __name__ == "__main__":
    main()

=== zip two lists for loop
def main() -> None:
    a: list[int] = [1, 2, 3]
    b: list[str] = ["a", "b", "c"]
    for x, y in zip(a, b):
        print(str(x) + y)
if __name__ == "__main__":
    main()

=== zip three lists for loop
def main() -> None:
    a: list[int] = [1, 2]
    b: list[str] = ["a", "b"]
    c: list[float] = [1.0, 2.0]
    for x, y, z in zip(a, b, c):
        print(str(x) + y)
if __name__ == "__main__":
    main()

=== zip bytes for loop
def main() -> None:
    a: bytes = b"\x01\x02\x03"
    b: bytes = b"\x04\x05\x06"
    for x, y in zip(a, b):
        print(str(x + y))
if __name__ == "__main__":
    main()

=== string iteration for loop
def main() -> None:
    s: str = "abc"
    result: list[str] = []
    for ch in s:
        result.append(ch)
    print(str(len(result)))
if __name__ == "__main__":
    main()

=== list repetition with annotation
def main() -> None:
    slots: list[int] = [0] * 5
    print(str(len(slots)))
if __name__ == "__main__":
    main()

=== dict get with default
def main() -> None:
    d: dict[str, int] = {"a": 0, "b": 2}
    x: int = d.get("a", 99)
    print(str(x))
if __name__ == "__main__":
    main()

=== list pop at index
def main() -> None:
    xs: list[str] = ["a", "b", "c"]
    first: str = xs.pop(0)
    print(first)
    print(str(len(xs)))
if __name__ == "__main__":
    main()

=== dict popitem
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2}
    k, v = d.popitem()
    print(k + "=" + str(v))
if __name__ == "__main__":
    main()

=== dict fromkeys
def main() -> None:
    keys: list[str] = ["x", "y", "z"]
    d: dict[str, int] = dict.fromkeys(keys, 0)
    print(str(len(d)))
if __name__ == "__main__":
    main()

=== dict from pairs
def main() -> None:
    pairs: list[tuple[str, int]] = [("a", 1), ("b", 2)]
    d: dict[str, int] = dict(pairs)
    print(str(len(d)))
if __name__ == "__main__":
    main()

