=== set from dict items
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2}
    s: set[tuple[str, int]] = set(d.items())
    print(str(len(s)))
if __name__ == "__main__":
    main()

=== list from dict
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
    ks: list[str] = sorted(list(d))
    print(str(len(ks)))
if __name__ == "__main__":
    main()

=== set from dict
def main() -> None:
    d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
    s: set[str] = set(d)
    print(str(len(s)))
if __name__ == "__main__":
    main()

=== star unpack two lists
def main() -> None:
    a: list[int] = [1, 2]
    b: list[int] = [3, 4]
    c: list[int] = [*a, *b]
    print(str(len(c)))
if __name__ == "__main__":
    main()

=== star unpack element then starred
def main() -> None:
    x: int = 1
    rest: list[int] = [2, 3]
    c: list[int] = [x, *rest]
    print(str(len(c)))
if __name__ == "__main__":
    main()

=== star unpack starred then element
def main() -> None:
    xs: list[int] = [1, 2]
    y: int = 3
    c: list[int] = [*xs, y]
    print(str(len(c)))
if __name__ == "__main__":
    main()

=== star unpack element starred element
def main() -> None:
    x: int = 1
    middle: list[int] = [2, 3]
    y: int = 4
    c: list[int] = [x, *middle, y]
    print(str(len(c)))
if __name__ == "__main__":
    main()
