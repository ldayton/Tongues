=== strip default whitespace
def main() -> None:
    s = "  hello  "
    x = s.strip()
    print(x)
if __name__ == "__main__":
    main()

=== strip custom chars
def main() -> None:
    s = "xxhelloxx"
    x = s.strip("xy")
    print(x)
if __name__ == "__main__":
    main()

=== lstrip default whitespace
def main() -> None:
    s = "  hello  "
    x = s.lstrip()
    print(x)
if __name__ == "__main__":
    main()

=== rstrip default whitespace
def main() -> None:
    s = "  hello  "
    x = s.rstrip()
    print(x)
if __name__ == "__main__":
    main()

=== fstring repr conversion
def main() -> None:
    x: int = 42
    print(f"{x!r}")
if __name__ == "__main__":
    main()

=== fstring str conversion
def main() -> None:
    x: int = 42
    print(f"{x!s}")
if __name__ == "__main__":
    main()

=== startswith with start position
def main() -> None:
    s: str = "hello world"
    print(s.startswith("world", 6))
if __name__ == "__main__":
    main()

=== strip regex special chars
def main() -> None:
    s: str = "]-hello-]"
    x: str = s.strip("]-")
    print(x)
if __name__ == "__main__":
    main()
