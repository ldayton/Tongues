=== read file binary mode
import sys
def read_data(path: str) -> bytes:
    with open(path, "rb") as fh:
        raw = fh.read()
    return raw
def main() -> None:
    data: bytes = read_data(sys.argv[1])
    sys.stdout.buffer.write(data)
if __name__ == "__main__":
    main()

=== bytes decode with replace error mode
import sys
def safe_decode(data: bytes) -> str:
    return data.decode("utf-8", errors="replace")
def main() -> None:
    raw: bytes = b"\x80\x81hello"
    result: str = safe_decode(raw)
    print(result)
if __name__ == "__main__":
    main()
