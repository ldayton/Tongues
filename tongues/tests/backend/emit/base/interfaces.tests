=== interface with fields
class Animal:
    name: str
    legs: int
class Dog(Animal):
    breed: str
BUDDY: Animal = Dog(name="Buddy", legs=4, breed="Mutt")
def main() -> None:
    x: str = BUDDY.name
    print(x)
if __name__ == "__main__":
    main()

=== class named Array does not collide with builtin
class Node:
    kind: str
class Array(Node):
    def __init__(self) -> None:
        self.kind = "array"
def main() -> None:
    a: Node = Array()
    print(a.kind)
if __name__ == "__main__":
    main()
