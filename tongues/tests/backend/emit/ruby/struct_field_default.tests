=== struct field with struct default
attr_accessor :name, :inner

=== computed field not in constructor params
@length = text.length

=== const kind field uses correct value
@kind = "my-node"

=== computed field references renamed param
def initialize(_prefix: "")
@_prefix = _prefix
@_label = _prefix.upper
end

=== error class with const kind field
def initialize(msg: "")
super(msg)
@msg = msg
@kind = "compile"
end
