=== struct field with struct default
attr_accessor :name, :inner

=== computed field not in constructor params
@length = text.length

=== const kind field uses correct value
@kind = "my-node"

=== computed field references renamed param
def initialize(_prefix: "")
@_prefix = _prefix
@_label = _prefix.upper
end

=== post-assignment nested field set in init
@child = Child.new(value: "ok")
self.child._parent = name

=== uppercase field name lowered for target language
def initialize(max_size: 0, name: "")
@max_size = max_size

=== error class with const kind field
def initialize(msg: "")
super(msg)
@msg = msg
@kind = "compile"
end
