=== isinstance check
a.is_a?(Dog)

=== isinstance with tuple of types
a.is_a?(Dog) || a.is_a?(Cat)

=== isinstance with str
x.is_a?(String)

=== isinstance with int
x.is_a?(Integer)

=== isinstance user class shadows builtin name
x.is_a?(List)

=== isinstance tuple of primitives
x.is_a?(String) || x.is_a?(Integer)
