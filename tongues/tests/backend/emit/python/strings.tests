=== strip default whitespace
s.strip(

=== strip custom chars
s.strip("xy")

=== lstrip default whitespace
s.lstrip(

=== rstrip default whitespace
s.rstrip(

=== fstring repr conversion
f"{repr(x)}"

=== fstring str conversion
f"{str(x)}"

=== startswith with start position
s.startswith("world", 6)

=== strip regex special chars
s.strip("]-")
