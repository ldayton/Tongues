=== math functions
console.log(String(Math.abs(-5)));

=== float math functions
const r = Math.round(3.7);

=== conversion functions
const f = 42;
const n = Math.trunc(3.14);

=== ParseInt and ParseFloat
const n = parseInt("42", 10);

=== FormatInt
const hex = (255).toString(16);

=== FormatInt octal
const oct = (255).toString(8);

=== FormatInt binary
const bin = (255).toString(2);

=== RuneToInt and RuneFromInt
const n = "A".codePointAt(0);

=== IsNaN and IsInf
console.log(String(Number.isNaN(x)));

=== Len on various types
console.log(String("hello".length));

=== DivMod
q = Math.trunc(17 / 5);
r = 17 - q * 5;

=== DivMod negative dividend
q = Math.trunc(-7 / 2);
r = -7 - q * 2;

=== Sqrt function
const x = Math.sqrt(2.0);

=== Floor function
const n = Math.floor(3.7);

=== Ceil function
const n = Math.ceil(3.2);

=== FloorDiv negative operands
const q = Math.floor(-7 / 2);

=== PythonMod negative dividend
const r = ((-7 % 2) + 2) % 2;

=== RangeList
const xs = Array.from({length: 5}, (_, i) => i);

=== RangeList with step
const xs = Array.from({length: 5}, (_, i) => i * 2);

=== ListFrom bytes
const xs = [...data];

