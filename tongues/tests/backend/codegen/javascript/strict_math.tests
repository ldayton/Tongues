=== float mod by zero traps
let caught = false;
try {
    let x = strict_fmod(1.0, 0.0);
} catch (_) {
    caught = true;
}
console.log(String(caught));

=== min with nan propagates
let nan = NaN;
let x = strict_min_f64(nan, 1.0);
console.log(String(Number.isNaN(x)));

=== max with nan propagates
let nan = NaN;
let x = strict_max_f64(nan, 1.0);
console.log(String(Number.isNaN(x)));

=== sorted with nan traps
let nan = NaN;
let caught = false;
try {
    let xs = strict_sorted_f64([1.0, nan, 2.0]);
} catch (_) {
    caught = true;
}
console.log(String(caught));

