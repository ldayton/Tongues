=== unused tuple target becomes underscore
q = Math.floor(17 / 5)

=== all tuple targets used
q = Math.floor(17 / 5)
r = 17 - q * 5

=== initial value suppressed when overwritten
x = parseInt(input, 10)

=== initial value kept when read before overwrite
let x = 0

=== Unwrap on optional
const v = x
