=== IO functions
print("no newline");

=== ReadAll and ReadLine
my $all = do { local $/; Encode::decode('UTF-8', scalar(<STDIN>), Encode::FB_CROAK) };

=== ReadLine returns optional
my $line = do { my $__l = scalar(<STDIN>); defined($__l) ? Encode::decode('UTF-8', $__l, Encode::FB_CROAK) : $__l };

=== ReadFile emits open idiom
my $data = do { my $__p = "input.txt"; open(my $__fh, '<:encoding(UTF-8)', $__p) or die $__p; local $/; my $__d = <$__fh>; close($__fh); $__d };

=== ReadFileBytes emits open idiom
my $data = do { my $__p = "input.txt"; open(my $__fh, '<:raw', $__p) or die $__p; local $/; my $__d = <$__fh>; close($__fh); $__d };

=== WriteFile emits open idiom
do { my $__p = "output.txt"; my $__d = "hello"; open(my $__fh, '>', $__p) or die $__p; print $__fh $__d; close($__fh) };

=== ReadBytesN
my $chunk = do { read(STDIN, my $__b, 1024); $__b };

=== Args and GetEnv
my $args = [@ARGV];

=== Exit call
exit(1);

=== Encode and Decode
my $b = Encode::encode('UTF-8', "hello");

=== bytes indexing
my $first = substr($b, 0, 1);

=== bytes slicing
my $part = substr($b, 1, (3) - (1));

=== Concat on bytes
my $c = ($a . $b);
