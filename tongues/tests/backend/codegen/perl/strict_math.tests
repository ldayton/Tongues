say(("" . $x));

=== float mod by zero traps
sub main {
my $caught = 0;
my $__ok0 = eval {
my $x = strict_fmod(1.0, 0.0);
1;
};
if (!$__ok0) {
my $__err1 = $@;
$caught = 1;
} elsif (ref($__ok0)) {
return $__ok0;
}
say(("" . $caught));
}

=== min with nan propagates
my $nan = 0.0 / 0.0;
my $x = strict_min_f64($nan, 1.0);
say(("" . (($x != $x) ? 1 : 0)));

=== max with nan propagates
my $nan = 0.0 / 0.0;
my $x = strict_max_f64($nan, 1.0);
say(("" . (($x != $x) ? 1 : 0)));

=== sorted with nan traps
sub main {
my $nan = 0.0 / 0.0;
my $caught = 0;
my $__ok0 = eval {
my $xs = strict_sorted_f64([1.0, $nan, 2.0]);
1;
};
if (!$__ok0) {
my $__err1 = $@;
$caught = 1;
} elsif (ref($__ok0)) {
return $__ok0;
}
say(("" . $caught));
}

