say(("" . $c));

=== checked int sub
my $c = checked_sub_i64($a, $b);
say(("" . $c));

=== checked int mul
my $c = checked_mul_i64($a, $b);
say(("" . $c));

=== checked int negate
my $y = checked_neg_i64($x);
say(("" . $y));

=== checked left shift
my $y = checked_shl_i64($x, 4);
say(("" . $y));

=== checked right shift
my $y = checked_shr_i64($x, 4);
say(("" . $y));

=== logical right shift
my $y = logical_shr_i64($x, 1);
say(("" . $y));

=== wrapping add
