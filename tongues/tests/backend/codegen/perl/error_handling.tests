=== unused catch variable is omitted
if (ref($__err1) eq 'ValueError') {
    say("bad");
} else {
    die $__err1;
}

=== used catch variable is kept
if (ref($__err1) eq 'ValueError') {
    my $e = $__err1;
    say($e->{message});
} else {
    die $__err1;
}

=== try with finally
if (!$__ok0) {
    my $__err1 = $@;
    if (ref($__err1) eq 'ValueError') {
        say("catch");
    } else {
        die $__err1;
    }
} elsif (ref($__ok0)) {
    return $__ok0;
}
say("finally");

=== try with multiple catch clauses
if (ref($__err1) eq 'ValueError') {
    say("value error");
} elsif (ref($__err1) eq 'KeyError') {
    say("key error");
} else {
    die $__err1;
}

=== re-throw in catch
die $e;

=== catch-all without type
my $e = $__err1;
say($e->{message});

=== catch-all after typed catch
if (ref($__err1) eq 'ErrA') {
    say("got A");
} else {
    my $e = $__err1;
    say($e->{message});
}

=== throw and catch struct
if (ref($__err1) eq 'AppError') {
    my $e = $__err1;
    say($e->{message});
} else {
    die $__err1;
}

=== catch union of both error types
if (ref($__err1) eq 'ErrA' || ref($__err1) eq 'ErrB') {
    my $e = $__err1;
    say($e->{message});
} else {
    die $__err1;
}

=== catch union of types
if (ref($__err1) eq 'ErrA' || ref($__err1) eq 'ErrB') {
    my $e = $__err1;
    say($e->{message});
} else {
    die $__err1;
}

=== throw bare Exception
die bless({message => "something went wrong"}, 'Exception');

=== throw builtin ValueError
die bless({message => "bad input"}, 'ValueError');

=== catch builtin ValueError
if (ref($__err1) eq 'ValueError') {
    my $e = $__err1;
    say($e->{message});
} else {
    die $__err1;
}

=== Assert with message
die("must be positive") unless ($x > 0);

=== Assert without message
die("assertion failed") unless ($x > 0);
