=== step slice on string (raised)
fn Main() -> void {
    let s: string = "abcdef"
    let r: string = ""
    @["provenance" = "step_slice"] for __i in range(0, Len(s), 2) {
        r = Concat(r, ToString(s[__i]))
    }
    WritelnOut(r)
}

