}

=== step slice on list (raised)
fn Main() -> void {
    let xs: list[int] = [1, 2, 3, 4, 5]
    let evens: list[int]
    @["provenance" = "step_slice"] for __i in range(0, Len(xs), 2) {
        Append(evens, xs[__i])
    }
    WritelnOut(ToString(Len(evens)))
}

