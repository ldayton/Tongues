=== not in operator (raised)
fn Main() -> void {
    let xs: list[int] = [1, 2, 3]
    if !@["provenance" = "not_in_operator"] Contains(xs, 2) {
        WritelnOut("missing")
    }
}

=== negative index via Len subtraction (raised)
fn Main() -> void {
    let xs: list[int] = [1, 2, 3]
    WritelnOut(ToString(@["provenance" = "negative_index"] xs[Len(xs) - 1]))
}

