=== nil to interface variable
interface Animal {}
struct Dog : Animal {
    name: string
}
fn Search(xs: list[Animal], name: string) -> Animal? {
    let result: Animal? = nil
    for x in xs {
        match x {
            case d: Dog {
                if d.name == name {
                    result = d
                }
            }
        }
    }
    return result
}
fn Main() -> void {
    let r: Animal? = Search([Dog("Rex")], "Rex")
    if r != nil {
        WritelnOut("found")
    }
}

=== interface common field accessor
interface Expr {}
struct Num : Expr {
    value: int
    pos: int
}
struct Add : Expr {
    left: Expr
    right: Expr
    pos: int
}
fn GetPos(e: Expr) -> int {
    return e.pos
}
fn Main() -> void {
    let e: Expr = Num(value: 42, pos: 1)
    WritelnOut(ToString(GetPos(e)))
}

=== IsType narrows for field access
interface Item {}
struct Book : Item {
    title: string
}
struct DVD : Item {
    title: string
}
fn GetTitle(it: Item) -> string {
    if IsType(it, "Book") {
        return it.title
    }
    return "unknown"
}
fn Main() -> void {
    WritelnOut(GetTitle(Book(title: "Dune")))
}

=== type switch binding shadows type name
interface Value {}
struct VInt : Value {
    n: int
}
struct VFloat : Value {
    n: float
}
fn Negate(operand: Value) -> Value {
    match operand {
        case VInt: VInt {
            return VInt(n: -VInt.n)
        }
        case VFloat: VFloat {
            return VFloat(n: -VFloat.n)
        }
    }
}
fn Main() -> void {
    WritelnOut("ok")
}

=== empty map in return statement
fn Empty() -> map[string, int] {
    return Map()
}
fn Main() -> void {
    WritelnOut(ToString(Len(Empty())))
}

=== match case binding shadows type in body
interface Value {}
struct VInt : Value {
    n: int
}
struct VStr : Value {
    s: string
}
fn Describe(v: Value) -> string {
    match v {
        case VInt: VInt {
            return ToString(VInt.n)
        }
        case VStr: VStr {
            return VStr.s
        }
    }
}
fn Main() -> void {
    WritelnOut(Describe(VInt(n: 42)))
}

=== map literal with interface value in return
interface Node {}
struct Leaf : Node {
    v: int
}
fn MakeMap() -> map[string, Node] {
    return {"a": Leaf(v: 1)}
}
fn Main() -> void {
    WritelnOut(ToString(Len(MakeMap())))
}

=== default string param fills zero value
fn Greet(name: string = "world") -> string {
    return name
}
fn Main() -> void {
    WritelnOut(Greet())
}

=== optional string field deref
struct Config {
    name: string?
}
fn GetName(c: Config) -> string {
    if c.name != nil {
        return c.name
    }
    return "default"
}
fn Main() -> void {
    WritelnOut(GetName(Config(name: "test")))
}

=== list literal with interface type in return
interface Node {}
struct Leaf : Node {
    v: int
}
fn Nodes() -> list[Node] {
    return [Leaf(v: 1)]
}
fn Main() -> void {
    WritelnOut(ToString(Len(Nodes())))
}
