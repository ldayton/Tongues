=== IO functions
$stdout.write("no newline")

=== ReadAll and ReadLine
all = $stdin.binmode.read.force_encoding('UTF-8').tap { |s| raise UnicodeDecodeError unless s.valid_encoding? }

=== ReadLine returns optional
line = $stdin.gets&.chomp

=== ReadFile emits open idiom
File.read("input.txt", encoding: "utf-8")

=== ReadFileBytes emits open idiom
File.binread("input.txt").bytes

=== WriteFile emits open idiom
File.write("output.txt", "hello")

=== ReadBytesN
chunk = $stdin.binmode.read(1024).bytes

=== Args and GetEnv
args = ARGV

=== Exit call
exit(1)

=== Encode and Decode
b = "hello".encode("utf-8").bytes

=== bytes indexing
first = b[0]

=== bytes slicing
part = b[1...3]

=== Concat on bytes
c = a + b
