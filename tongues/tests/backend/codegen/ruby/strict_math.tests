=== checked int add
c = checked_add_i64(a, b)
puts(_py_str(c))

=== checked int sub
c = checked_sub_i64(a, b)
puts(_py_str(c))

=== checked int mul
c = checked_mul_i64(a, b)
puts(_py_str(c))

=== checked int negate
y = checked_neg_i64(x)
puts(_py_str(y))

=== checked left shift
y = checked_shl_i64(x, 4)
puts(_py_str(y))

=== checked right shift
y = checked_shr_i64(x, 4)
puts(_py_str(y))

=== logical right shift
y = logical_shr_i64(x, 1)
puts(_py_str(y))

=== wrapping add
b = wrapping_add(a, 1)
puts(_py_str(b))

=== wrapping sub
b = wrapping_sub(min, 1)
puts(_py_str(b))

=== wrapping mul
b = wrapping_mul(max, 2)
puts(_py_str(b))

=== checked pow
x = checked_pow_i64(2, 10)
puts(_py_str(x))

=== checked int compound add
x = checked_add_i64(x, 5)
puts(_py_str(x))

=== checked int compound sub
x = checked_sub_i64(x, 3)
puts(_py_str(x))

=== checked int compound mul
x = checked_mul_i64(x, 3)
puts(_py_str(x))

=== float mod by zero traps
def main()
caught = false
begin
x = strict_fmod(1.0, 0.0)
rescue
caught = true
end
puts(_py_str(caught))
end

=== min with nan propagates
nan = 0.0 / 0.0
x = strict_min_f64(nan, 1.0)
puts(_py_str(x.nan?))

=== max with nan propagates
nan = 0.0 / 0.0
x = strict_max_f64(nan, 1.0)
puts(_py_str(x.nan?))

=== sorted with nan traps
def main()
nan = 0.0 / 0.0
caught = false
begin
xs = strict_sorted_f64([1.0, nan, 2.0])
rescue
caught = true
end
puts(_py_str(caught))
end

=== bigint int literal
x = 42
puts(_py_str(x))

=== preamble no number conversion
c = checked_add_i64(a, b)
puts(_py_str(c))

=== bigint for range
(0...10).each do |i|

=== bigint array index
v = xs[i]

=== bigint int to float
f = x.to_f

=== bigint float to int
x = f.to_i

=== bigint len
n = xs.length

=== non-strict ops unchanged
x = 1.5 + 2.5
y = checked_div_i64(10, 3)
z = checked_rem_i64(10, 3)
puts(_py_str(y))
