=== math functions
puts(_py_str((-5).abs))

=== float math functions
r = 3.7.round

=== conversion functions
f = 42.to_f
n = 3.14.to_i
b = [65].pack('U')
i = b.ord

=== ParseInt and ParseFloat
n = "42".to_i(10)

=== FormatInt
hex = 255.to_s(16)

=== FormatInt octal
oct = 255.to_s(8)

=== FormatInt binary
bin = 255.to_s(2)

=== RuneToInt and RuneFromInt
n = "A".ord

=== IsNaN and IsInf
puts(_py_str(x.nan?))

=== Len on various types
puts(_py_str("hello".length))

=== DivMod
q = (17.to_f / 5).floor
r = 17 - q * 5

=== DivMod negative dividend
q = (-7.to_f / 2).floor
r = -7 - q * 2

=== Sqrt function
x = Math.sqrt(2.0)

=== Floor function
n = 3.7.floor

=== Ceil function
n = 3.2.ceil

=== FloorDiv negative operands
q = -7 / 2

=== PythonMod negative dividend
r = -7 % 2

=== RangeList
xs = (0...5).to_a

=== RangeList with step
xs = (0...10).step(2).to_a

=== ListFrom bytes
xs = data.bytes

=== IsNil check
x.nil?
