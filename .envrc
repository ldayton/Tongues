# Tongues development environment
# Run `just versions` to compare local vs Docker-expected versions

# Detect Homebrew prefix
if [[ -d /opt/homebrew ]]; then
  BREW=/opt/homebrew
elif [[ -d /home/linuxbrew/.linuxbrew ]]; then
  BREW=/home/linuxbrew/.linuxbrew
else
  echo "warning: Homebrew not found" >&2
fi

# Pinned versions (matching Docker)
export PATH="$BREW/opt/gcc@13/bin:$PATH"
export PATH="$BREW/opt/dotnet@8/bin:$PATH"
export DOTNET_ROOT="$BREW/opt/dotnet@8/libexec"
export PATH="$BREW/opt/go@1.21/bin:$PATH"
export PATH="$BREW/opt/openjdk@21/bin:$PATH"
export PATH="$BREW/opt/php@8.3/bin:$PATH"
export PATH="$BREW/opt/python@3.12/bin:$PATH"
export PATH="$BREW/opt/ruby@3.3/bin:$PATH"
export PATH="$BREW/lib/ruby/gems/3.3.0/bin:$PATH"
export PATH="$BREW/opt/node@20/bin:$PATH"
export PATH="$BREW/opt/perl/bin:$PATH"
export PATH="$BREW/opt/dart-sdk/bin:$PATH"
export PATH="$BREW/opt/zig@0.14/bin:$PATH"
export PATH="$BREW/opt/lua/bin:$PATH"

# TypeScript (local npm install, no brew formula)
export PATH="$PWD/.direnv/typescript/node_modules/.bin:$PATH"

# Home-managed tools
export PATH="$HOME/perl5/bin:$PATH"
export PATH="$HOME/.dotnet/tools:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"              # Rustup-managed (1.75.0)

# Swift: Xcode on macOS, Homebrew on Linux
if [[ "$(uname)" == "Linux" ]]; then
  export PATH="$BREW/opt/swift/bin:$PATH"
fi

# Provision TypeScript locally if missing
if [[ ! -x "$PWD/.direnv/typescript/node_modules/.bin/tsc" ]]; then
  npm install --prefix "$PWD/.direnv/typescript" typescript@5.3 >/dev/null 2>&1
fi

# Create .direnv/bin symlinks
mkdir -p "$PWD/.direnv/bin"
ln -sf "$BREW/opt/gcc@13/bin/gcc-13" "$PWD/.direnv/bin/gcc"
ln -sf "$BREW/opt/python@3.12/bin/python3.12" "$PWD/.direnv/bin/python"
ln -sf "$BREW/opt/python@3.12/bin/python3.12" "$PWD/.direnv/bin/python3"

# Local symlinks (must be last to take priority)
export PATH="$PWD/.direnv/bin:$PATH"
